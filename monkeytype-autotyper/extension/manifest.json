{
  "manifest_version": 3,
  "name": "Monkeytype Autotyper",
  "version": "1.1.0",
  "description": "Floating autotyper for monkeytype.com with WPM control, jitter, random speed and intentional errors.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "https://monkeytype.com/*",
    "https://www.monkeytype.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://monkeytype.com/*",
        "https://www.monkeytype.com/*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Monkeytype Autotyper"
  }
}
